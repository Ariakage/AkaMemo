{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AkaMemo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AkaMemo"
          }
        }
      }
    },
    "audioPurge.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear audio (keep transcript)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理音频（保留转写）"
          }
        }
      }
    },
    "audioPurge.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear audio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理音频"
          }
        }
      }
    },
    "audioPurge.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio cleared; transcripts remain searchable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频已清理，转写仍可搜索。"
          }
        }
      }
    },
    "audioPurge.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes this session's audio files and keeps transcripts, search and metadata. Chunks without a transcript can no longer be transcribed. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除本会话的音频文件，保留转写、索引与元数据；尚未转写的分片将无法再转写。操作无法恢复。"
          }
        }
      }
    },
    "audioPurge.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear audio?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理音频？"
          }
        }
      }
    },
    "battery.banner.low": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch battery is low. Recording continues; charge now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 电量低，录音仍在继续，请尽快充电。"
          }
        }
      }
    },
    "battery.banner.notificationsOff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off; low-battery alerts will not appear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭，不会收到低电量提醒。"
          }
        }
      }
    },
    "battery.banner.stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch battery reached 3%. Recording was paused and saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 电量 3%，录音已暂停并保存。"
          }
        }
      }
    },
    "battery.notification.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was paused and saved. Charge now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音已暂停并保存。请尽快充电。"
          }
        }
      }
    },
    "battery.notification.body.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is still running. Charge now, or open AkaMemo to stop recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音仍在继续。请尽快充电，或打开 AkaMemo 停止录音。"
          }
        }
      }
    },
    "battery.notification.title.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch battery is 3%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 电量仅 3%"
          }
        }
      }
    },
    "battery.notification.title.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch battery is 5%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 电量仅 5%"
          }
        }
      }
    },
