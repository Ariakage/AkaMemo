    "deletion.message.all": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All recordings, transcripts, index entries, and location data will be permanently deleted. Copies in existing iCloud backups must be managed in system backup settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有录音、转写、索引与位置数据都会永久删除；已存在的 iCloud 备份副本需在系统备份设置中管理。"
          }
        }
      }
    },
    "deletion.message.chunk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this chunk and its transcript are deleted. Other chunks in the session are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只删除该分片及其转写，不影响同一会话的其他分片。"
          }
        }
      }
    },
    "deletion.message.session": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio, transcripts, index entries, and location data will be permanently deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频、转写、索引和位置数据都会被永久删除，无法恢复。"
          }
        }
      }
    },
    "deletion.title.all": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
