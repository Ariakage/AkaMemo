    "settings.silentResume.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutes app sounds and haptics only; the system microphone indicator stays visible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅关闭应用提示音与触觉，系统麦克风指示仍可见。"
          }
        }
      }
    },
    "storage.warning.1gb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than 1 GB free. Consider clearing space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储不足 1 GB，请清理空间。"
