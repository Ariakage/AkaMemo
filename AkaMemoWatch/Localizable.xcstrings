    "watch.onboarding.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record on the Watch; chunks are stored locally and sent to iPhone. Nothing is uploaded by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Watch 上录音，分片保存在本机并传到 iPhone；默认不上传。"
          }
        }
      }
    },
    "watch.onboarding.location.allow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许定位"
          }
        }
      }
    },
    "watch.onboarding.location.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One point every 5 minutes while recording. Recording works if declined; you can turn it off in iPhone Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音期间每 5 分钟记录一个位置点；拒绝仍可录音，可在 iPhone 设置中关闭。"
          }
        }
      }
    },
    "watch.onboarding.location.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not allowed. You can enable it in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授权，可在系统设置中开启。"
          }
        }
      }
    },
    "watch.onboarding.location.granted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "watch.onboarding.location.notRequested": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not requested yet"
