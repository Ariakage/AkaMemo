    },
    "battery.warning.10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery 10%. Charge as soon as possible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量 10%，建议尽快充电。"
