      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denied. Allow AkaMemo in Watch Settings > Privacy & Security > Microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝。请在 Watch 设置 > 隐私与安全性 > 麦克风 中允许 AkaMemo。"
