  "strings": {
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AkaMemo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AkaMemo"
          }
        }
      }
    },
    "battery.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery monitoring unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量监测不可用"
          }
        }
      }
    },
    "battery.warning.10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery 10%. Charge as soon as possible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量 10%，建议尽快充电。"
          }
        }
      }
    },
    "battery.warning.20": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery 20%. Charging recommended; recording continues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量 20%，建议充电，录音继续。"
          }
        }
      }
    },
    "battery.warning.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery 3%. Recording paused and saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量 3%，录音已暂停并保存。"
          }
        }
      }
    },
    "battery.warning.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery 5%. Recording continues; charge now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量 5%，录音继续，请尽快充电。"
          }
        }
      }
    },
