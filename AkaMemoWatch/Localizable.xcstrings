    "storage.warning.critical": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than 500 MB free. Recording stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储不足 500 MB，录音已停止。"
