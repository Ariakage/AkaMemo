    },
    "battery.warning.20": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery 20%. Charging recommended; recording continues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量 20%，建议充电，录音继续。"
